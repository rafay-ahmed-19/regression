MONGO_URL=mongodb://localhost:27017
DB_NAME=regression_hub
CORS_ORIGINS=http://localhost:5173

# Load demo suites and run history into an empty database.
SEED_DEMO=true
# Multiplier for simulated step and query durations (0 = instant).
SIM_SPEED=1.0

# AI failure analysis (optional). Without a key the Analyse failure panel reports that it is not configured.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
